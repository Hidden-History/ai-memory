# TD-582 test fixture — bare-up simulation .env
# Non-secret-class keys; simulates ~/.ai-memory/docker/.env at bare-up time.
# Secret-class keys are intentionally absent — they live in .env.secrets.
AI_MEMORY_CONTAINER_PREFIX=td582-test
QDRANT_PORT=26350
QDRANT_GRPC_PORT=26351
QDRANT_LOG_LEVEL=INFO
GRAFANA_ADMIN_USER=admin
AI_MEMORY_LOG_LEVEL=INFO
MODEL_NAME_EN=jinaai/jina-embeddings-v2-base-en
MODEL_NAME_CODE=jinaai/jina-embeddings-v2-base-code
EMBEDDING_PORT=28080
EMBEDDING_MEMORY_LIMIT=4G
COLBERT_ENABLED=false
