# =============================================================================
# AI MEMORY MODULE — Environment Configuration
# =============================================================================
#
# Primary configuration file. Docker Compose reads it from docker/.env
# via the env_file: directive — all Python services receive every key automatically.
# No per-key hand-mapping in docker-compose.yml (see x-python-service-defaults anchor).
#
# OPTIONAL SENSITIVE SPLIT:
#   For stricter secrets hygiene, copy docker/.env.secrets.example to docker/.env.secrets
#   (chmod 600) and put your API keys there instead of this file. The installer does this
#   automatically. Keys in .env.secrets override matching keys in .env.
#
# SETUP:
#   1. Copy: cp .env.example .env
#   2. Fill in Section 1 (Your API Keys) — only the integrations you use
#   3. Run the installer: ./scripts/install.sh /path/to/your/project
#      The installer auto-generates all Section 2 credentials and starts Docker.
#
# After install, manage the stack with: scripts/stack.sh start|stop|restart|status
#
# Everything left blank in Section 2 is auto-generated by the installer.
# Everything in Sections 3-6 has working defaults — change only if needed.
#
# IMPORTANT: Do NOT put inline comments on KEY=value lines.
# Docker Compose and pydantic-settings parse them as part of the value.
#
# =============================================================================


# =============================================================================
# SECTION 1: YOUR API KEYS
# =============================================================================
# These are the ONLY values you need to provide manually.
# Leave blank any integrations you don't use.
# =============================================================================

# --- LLM Providers (at least one needed for memory classification) ---
# secret — see docker/.env.secrets.example
# Ollama Cloud: https://ollama.com/settings/keys (optional)
OLLAMA_API_KEY=
# secret — see docker/.env.secrets.example
# OpenRouter: https://openrouter.ai/keys (recommended, free tier available)
OPENROUTER_API_KEY=
# secret — see docker/.env.secrets.example
# Anthropic: https://console.anthropic.com/ (optional)
ANTHROPIC_API_KEY=
# secret — see docker/.env.secrets.example
# OpenAI: https://platform.openai.com/api-keys (optional)
OPENAI_API_KEY=

# --- GitHub Integration ---
# secret — see docker/.env.secrets.example
# Fine-grained token: https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=
# Format: owner/repo (e.g., myorg/myproject)
GITHUB_REPO=

# --- Jira Integration ---
# Your Atlassian account email
JIRA_EMAIL=
# secret — see docker/.env.secrets.example
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Instance URL, e.g., https://yourteam.atlassian.net
JIRA_INSTANCE_URL=
# JSON array of project keys, e.g. ["PROJ"] or ["PROJ","TEAM"]
JIRA_PROJECTS=


# =============================================================================
# SECTION 2: AUTO-GENERATED — DO NOT EDIT
# =============================================================================
# The installer and langfuse_setup.sh auto-generate these on first install.
# VALUES ARE STORED IN docker/.env.secrets (chmod 600), NOT in this file.
# Entries below are blank placeholders; see docker/.env.secrets.example for
# the authoritative list. To regenerate: delete the value in .env.secrets and
# re-run the installer.
# =============================================================================

# --- Vector Database (installer generates) ---
QDRANT_API_KEY=
# Auto-generated: installer generates a dedicated read-only key for Qdrant search operations
# Used by: Python config (qdrant_read_only_api_key field in config.py)
QDRANT_READ_ONLY_API_KEY=

# --- Monitoring (installer generates) ---
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=
PROMETHEUS_ADMIN_PASSWORD=
# Derived from PROMETHEUS_ADMIN_PASSWORD
PROMETHEUS_BASIC_AUTH_HEADER=

# --- Langfuse Secrets (langfuse_setup.sh generates) ---
# Langfuse internal secrets (LANGFUSE_DB_PASSWORD, LANGFUSE_CLICKHOUSE_PASSWORD,
# LANGFUSE_NEXTAUTH_SECRET, LANGFUSE_SALT, LANGFUSE_ENCRYPTION_KEY):
# These are PP-2 auto-generated secrets. Set them in docker/.env.secrets.example,
# NOT here. (BUG-296: legacy blank placeholders removed.)
LANGFUSE_S3_ACCESS_KEY=
LANGFUSE_S3_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Langfuse Bootstrap (langfuse_setup.sh generates) ---
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# --- Installer-Managed ---
# Set by installer (e.g., /home/user/.ai-memory)
AI_MEMORY_INSTALL_DIR=
# Set by installer (from git remote or folder name)
AI_MEMORY_PROJECT_ID=
# Container name prefix (for multi-stack isolation)
AI_MEMORY_CONTAINER_PREFIX=ai-memory


# =============================================================================
# SECTION 3: FEATURE TOGGLES
# =============================================================================
# All features enabled by default. Disable what you don't need.
# =============================================================================

# Auto-update ai-memory hooks on session start
AUTO_UPDATE_ENABLED=true
# Source-of-truth (aim-sot) digest + drift hooks are auto-registered on install (default on).
# Set to 'off' to skip auto-registering aim-sot digest/drift hooks.
# AI_MEMORY_SOT_HOOKS=off
# SOT discovery/digest walk bounds. Defaults keep the default-on [CL] Stop-hook
# under its ~20s subprocess cap. Raising them helps a manual
# `aim-sot detect-propose run` finish on a large tree, but can push the [CL] hook
# past the cap (it then truncates gracefully + warns).
# SOT discovery scan wall-time budget (seconds)
# AI_MEMORY_SOT_DISCOVERY_MAX_SECONDS=6.0
# SOT discovery scan max directories
# AI_MEMORY_SOT_DISCOVERY_MAX_DIRS=5000
# SOT tree-digest wall-time budget (seconds)
# AI_MEMORY_SOT_DIGEST_MAX_SECONDS=18.0
# SOT tree-digest max files
# AI_MEMORY_SOT_DIGEST_MAX_FILES=20000
# SOT per-entry reindex loop wall-time budget (seconds). Governs a manual
# detect-propose reindex, not the [CL] hot path — safe to raise for large trees.
# AI_MEMORY_SOT_REINDEX_MAX_SECONDS=30.0
# R1 discovery cadence (BP-047 hot/cold split): the drift loop runs every session;
# the discovery walk runs only when one of these is due (or forced via --discover).
# re-run discovery after this age (24 h)
# AI_MEMORY_SOT_DISCOVERY_TTL_SECONDS=86400
# ...or after this many sessions
# AI_MEMORY_SOT_DISCOVERY_SESSION_INTERVAL=20
# non-blocking nudge after N sessions with no run
# AI_MEMORY_SOT_DISCOVERY_NUDGE_SESSIONS=10
# R4 whole-tree size guard (BP-051 Policy 3): a boundary covering more than this
# many files is flagged with a narrowing recommendation — a guard, not a mechanism
# selector (the drift strategy is unchanged).
# AI_MEMORY_SOT_WHOLE_TREE_FILE_THRESHOLD=10000
# Load ColBERT reranking model (~400MB download)
COLBERT_ENABLED=true
# ColBERT late-interaction reranking in search
COLBERT_RERANKING_ENABLED=true
# Time-based relevance decay for memories
DECAY_ENABLED=true
# Git-based freshness detection for code-patterns
FRESHNESS_ENABLED=true
# Store GitHub file contents as vectors
GITHUB_CODE_BLOB_ENABLED=true
# Sync GitHub issues/PRs/commits to memory (requires GITHUB_TOKEN)
GITHUB_SYNC_ENABLED=false
# Dense+sparse hybrid search with RRF fusion
HYBRID_SEARCH_ENABLED=true
# Progressive context injection (Tier 1 + Tier 2)
INJECTION_ENABLED=true
# Sync Jira issues/comments to memory (requires JIRA_API_TOKEN)
JIRA_SYNC_ENABLED=false
# LLM observability (adds ~16 GiB RAM, requires langfuse_setup.sh)
LANGFUSE_ENABLED=false
# LLM-based memory type classification
MEMORY_CLASSIFIER_ENABLED=true
# Parzival project oversight agent
PARZIVAL_ENABLED=true
# Security scanning for stored content
SECURITY_SCANNING_ENABLED=true
# Set to false to skip monitoring health checks (e.g. minimal stack without monitoring profile)
MONITORING_ENABLED=true
# Comma-separated Compose profiles activated at install time (e.g. monitoring,github).
# Populated automatically by the installer; do not edit manually.
COMPOSE_PROFILES=


# =============================================================================
# SECTION 4: CONFIGURATION
# =============================================================================
# Grouped by subsystem. Defaults work out of the box.
# =============================================================================

# --- 4.1 LLM Providers & Models ---
# Auto-detects cloud if OLLAMA_API_KEY is set
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_KEEP_ALIVE: Controls how long the classifier model stays loaded in VRAM.
# Default Ollama behavior: evict after 5 minutes idle → causes cold-start timeouts (BUG-290).
# THIS IS A HOST-SIDE Ollama variable — set it on the Ollama daemon, not in this file.
#
# Linux (systemd): sudo systemctl edit ollama.service
#   Add under [Service]:  Environment="OLLAMA_KEEP_ALIVE=-1"
#   Then: sudo systemctl daemon-reload && sudo systemctl restart ollama
#
# Docker (compose-managed Ollama): add to your ollama service env block:
#   OLLAMA_KEEP_ALIVE=-1
#
# Windows/macOS: set OLLAMA_KEEP_ALIVE=-1 in your shell profile before starting Ollama.
#
# Recommended: -1 (keep loaded indefinitely — safe for single-model classifier hosts)
# OLLAMA_KEEP_ALIVE=-1
OLLAMA_MODEL=llama3.2:3b
# Use official Ollama project models only (e.g. llama3.2:3b, gemma2:2b). Avoid user-namespace models (e.g. sam860/...) — upstream removal risk.
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Verify active: GET https://openrouter.ai/api/v1/models | grep OPENROUTER_MODEL value
# Fallbacks: openai/gpt-oss-20b:free, nvidia/nemotron-nano-9b-v2:free
# Only stable-namespace models (meta-llama, openai, nvidia) should be used as defaults (BP-156 §1.4)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Re-validate Q1 2027 (retirement not before Oct 15, 2026 per Anthropic model lifecycle)
OPENAI_MODEL=gpt-4o-mini

# --- 4.2 Memory Classifier ---
# Primary provider: ollama | openrouter | claude | openai
MEMORY_CLASSIFIER_PRIMARY_PROVIDER=ollama
# Comma-separated fallback chain
MEMORY_CLASSIFIER_FALLBACK_PROVIDERS=openrouter
MEMORY_CLASSIFIER_CONFIDENCE_THRESHOLD=0.7
MEMORY_CLASSIFIER_RULE_CONFIDENCE=0.85
MEMORY_CLASSIFIER_MIN_CONTENT_LENGTH=20
MEMORY_CLASSIFIER_TIMEOUT=120
MEMORY_CLASSIFIER_MAX_TOKENS=500
MEMORY_CLASSIFIER_MAX_INPUT_CHARS=4000

# --- 4.3 Context Injection ---
# Tier 1 startup injection budget (tokens)
BOOTSTRAP_TOKEN_BUDGET=2500
# Tier 1 per-tier ceiling for L1 handoff retrieval (tokens, ge=2500 le=10000).
# Independent of BOOTSTRAP_TOKEN_BUDGET; sized for whole-handoff aggregation
# (Jina Embeddings v2 single-vector ceiling). BP-158 §5.
HANDOFF_CEILING_TOKENS=8000
# Tier 2 min score to inject
INJECTION_CONFIDENCE_THRESHOLD=0.6
INJECTION_BUDGET_FLOOR=500
INJECTION_BUDGET_CEILING=1500
# INJECTION_QUALITY_WEIGHT=0.5
# INJECTION_DENSITY_WEIGHT=0.3
# INJECTION_DRIFT_WEIGHT=0.2
# INJECTION_HARD_FLOOR=0.45
# INJECTION_THRESHOLD_CONVENTIONS=0.65
# INJECTION_THRESHOLD_CODE_PATTERNS=0.55
# INJECTION_THRESHOLD_DISCUSSIONS=0.60
# BUG-319 / BP-174 — absolute-relevance injection gate (raw cosine floor +
# scale-free margin + freshness cap). ENABLED + CALIBRATED per DEC-PM343-D7
# (live read-only sweep; see oversight calibration.md). Floor 0.76 splits the
# off-topic raw ceiling (~0.754) from the on-topic cluster (>=0.760). Margin and
# freshness are off (0) — non-discriminative in a single-domain store. The gate
# defers (no skip) when the top results have no dense neighbor (best_raw == 0.0).
INJECTION_ABSOLUTE_GATE_ENABLED=true
INJECTION_ABSOLUTE_FLOOR=0.76
INJECTION_MARGIN_MIN=0.0
INJECTION_FRESHNESS_MAX_AGE_DAYS=0
INJECTION_DRIFT_SUPPRESSOR_THRESHOLD=0.5

# --- 4.4 Decay Scoring ---
# Blend: 0.7 semantic + 0.3 temporal
DECAY_SEMANTIC_WEIGHT=0.7
# Days until 50% decay per collection
DECAY_HALF_LIFE_CODE_PATTERNS=14
DECAY_HALF_LIFE_DISCUSSIONS=21
DECAY_HALF_LIFE_CONVENTIONS=60
DECAY_HALF_LIFE_JIRA_DATA=30
DECAY_HALF_LIFE_GITHUB=14
# DECAY_MIN_SCORE=0.1
# DECAY_TYPE_OVERRIDES=

# --- 4.5 Freshness Detection ---
# Commits since stored to classify as aging/stale/expired
FRESHNESS_COMMIT_THRESHOLD_AGING=3
FRESHNESS_COMMIT_THRESHOLD_STALE=10
FRESHNESS_COMMIT_THRESHOLD_EXPIRED=25
# FRESHNESS_PENALTY_FRESH=1.0
# FRESHNESS_PENALTY_AGING=0.9
# FRESHNESS_PENALTY_STALE=0.0
# FRESHNESS_PENALTY_EXPIRED=0.0
# FRESHNESS_PENALTY_UNVERIFIED=1.0
# FRESHNESS_PENALTY_UNKNOWN=0.8

# --- 4.6 Security Scanning ---
SECURITY_SCANNING_NER_ENABLED=true
SECURITY_BLOCK_ON_SECRETS=true
# Scan modes: relaxed | strict | off
SECURITY_SCAN_GITHUB_MODE=relaxed
SECURITY_SCAN_SESSION_MODE=relaxed

# --- 4.7 GitHub Sync ---
GITHUB_BRANCH=main
# Sync interval in seconds (1800 = 30 min)
GITHUB_SYNC_INTERVAL=1800
GITHUB_SYNC_ON_START=true
# Max file size for code blob storage (bytes)
GITHUB_CODE_BLOB_MAX_SIZE=102400
GITHUB_CODE_BLOB_EXCLUDE=node_modules,*.min.js,.git,__pycache__,*.pyc,build,dist,*.egg-info
# Advanced: concurrent file processing and batch storage
# GITHUB_CODE_BLOB_FILE_CONCURRENCY=2
# GITHUB_CODE_BLOB_CHUNK_BATCH_SIZE=8
# GITHUB_CODE_BLOB_BATCH_STORAGE_ENABLED=true
# Comma-separated glob patterns to force-include (bypasses standard filter skips, not binary protection)
# Supported: *.ext (extension match) or bare-token (path segment match, e.g. Makefile)
# NOT supported: path patterns with / (e.g. src/*.py), bare * or *. (too broad)
# GITHUB_CODE_BLOB_INCLUDE=
# Optional hard ceiling for explicitly included files (defaults to 5x GITHUB_CODE_BLOB_MAX_SIZE)
# GITHUB_CODE_BLOB_INCLUDE_MAX_SIZE=
# Total timeout for code blob sync in service mode (seconds; default 30 min).
# Large repos (>2000 files): consider 3600 (1h) or more for first sync.
# Files that exceed the timeout are recorded and prioritized next cycle (BUG-288 reconciliation).
GITHUB_SYNC_TOTAL_TIMEOUT=1800
GITHUB_SYNC_INSTALL_TIMEOUT=600
GITHUB_SYNC_PER_FILE_TIMEOUT=60
GITHUB_SYNC_CIRCUIT_BREAKER_THRESHOLD=5
GITHUB_SYNC_CIRCUIT_BREAKER_RESET=60

# --- 4.8 Jira Sync ---
# Delay between Jira API calls in ms (rate limiting)
JIRA_SYNC_DELAY_MS=100

# --- 4.9 Parzival Agent ---
# Your name (used in greetings and handoffs)
PARZIVAL_USER_NAME=Developer
PARZIVAL_LANGUAGE=English
PARZIVAL_DOC_LANGUAGE=English
# Project-relative path to oversight directory
PARZIVAL_OVERSIGHT_FOLDER=oversight
PARZIVAL_HANDOFF_RETENTION=10

# --- 4.10 Langfuse Observability ---
# Langfuse web UI URL (for Python SDK)
LANGFUSE_BASE_URL=http://localhost:23100
# Trace retention in days
LANGFUSE_RETENTION_DAYS=90
# Trace flush worker interval in seconds
LANGFUSE_FLUSH_INTERVAL=5
LANGFUSE_TRACE_HOOKS=true
LANGFUSE_TRACE_SESSIONS=true

# --- 4.11 Embedding Models ---
MODEL_NAME_EN=jinaai/jina-embeddings-v2-base-en
MODEL_NAME_CODE=jinaai/jina-embeddings-v2-base-code
EMBEDDING_MODEL_DENSE_EN=jinaai/jina-embeddings-v2-base-en
EMBEDDING_MODEL_DENSE_CODE=jinaai/jina-embeddings-v2-base-code
# Container memory limit. Default 10G (BUG-329 / DEC-PM386-D4 + PM #390): this is the
# design basis of the byte-aware envelope below — warm base ~2.35 GiB + ~5.6 GiB in-flight
# char budget = ~7.95 GiB peak, ~2 GiB headroom. The envelope (EMBEDDING_SAFE_INFLIGHT_CHARS
# etc.) is sized against THIS limit, so it must stay in lockstep — shipping a smaller limit
# would OOM a fresh install. Size by concurrent-project count — see docs/EMBEDDING-SIZING.md.
EMBEDDING_MEMORY_LIMIT=10G
EMBEDDING_MAX_RETRIES=2
EMBEDDING_BACKOFF_BASE=1.0
EMBEDDING_BACKOFF_CAP=15.0
# TD-689: client-side sub-batch size for batch storage. Keep <= the service's
# EMBEDDING_MAX_BATCH_TEXTS so a large batch is split client-side instead of being
# rejected (413) and degraded to PENDING.
EMBEDDING_CLIENT_SUBBATCH=128
# Memory-safety envelope: cap on concurrent in-flight texts the client admits before
# back-pressuring, sized below the client sub-batch so it bounds peak embedding-server
# memory. Hierarchy: SAFE_INFLIGHT(48) <= CLIENT_SUBBATCH(128) <= MAX_BATCH_TEXTS(256).
# The embedding server enforces the same envelope directly — a lone request whose
# work-units exceed it is rejected with HTTP 413.
EMBEDDING_SAFE_INFLIGHT_TEXTS=48
# TD-783 (PM #390): byte/superlinear-aware companion to the count envelope above. Bounds
# the SUM of in-flight CHARS across concurrent slots, so peak memory tracks byte-work
# rather than text count (48 texts is safe at 2 KB/text but OOM'd the 10 GiB cap at
# 8 KB/text = 393,216 chars). 200,000 chars -> ~5.6 GiB transient -> ~7.95 GiB peak,
# ~20% headroom under 10 GiB. The count envelope stays as the client-mirrored contract;
# this is the binding memory bound under large-text bursts.
EMBEDDING_SAFE_INFLIGHT_CHARS=200000
# TD-774/TD-782: per-request read timeout for the en model (seconds). Floored in code to
# EMBEDDING_ACQUIRE_TIMEOUT + EMBEDDING_INFERENCE_TIMEOUT (the coherent 60s default) so it
# cannot expire before the server can respond; a LARGER value is honoured for slower
# hardware, a smaller one is raised to the floor. GPU mode can lower the inference term.
EMBEDDING_READ_TIMEOUT=60.0
# Per-request read timeout for the code model (seconds). Same coherent floor applies; set
# it above the en value only if code embeds are measurably slower on your hardware.
EMBEDDING_READ_TIMEOUT_CODE=60
# BUG-329/TD-710 + TD-782/788: overall wall-clock deadline (seconds) for embed()'s retry
# loop. Made inference-time-aware — its default and lower floor are the coherent
# single-attempt budget (EMBEDDING_ACQUIRE_TIMEOUT + EMBEDDING_INFERENCE_TIMEOUT, 60s) so
# it cannot clip a legitimate attempt; a smaller configured value is floored up WITH a
# warning. Caps each attempt's READ/inference timeout to the remaining budget, so the read
# phase itself can never exceed this value. It is NOT an exact ceiling on total wall-clock
# time: the fixed httpx connect+write+pool overhead (~11s) on each attempt is not
# budget-capped, so worst-case wall-clock per call is roughly EMBEDDING_TOTAL_TIMEOUT +
# 11s. That combined figure must stay below the store hooks' HOOK_TIMEOUT (coherent
# default 90s), or the hook's own timeout can still fire first and abort the store
# coroutine before this deadline gets a chance to raise EMBEDDING_TIMEOUT for the
# pending-status fallback to run. A construction-time check warns if the invariant is
# violated.
EMBEDDING_TOTAL_TIMEOUT=60.0
# TD-782/788: realistic worst-case single-request inference time (seconds). It is added
# to the server admission wait (EMBEDDING_ACQUIRE_TIMEOUT, in the resilience section
# below) to form the coherent client read-timeout floor: the client read timeout is
# raised to at least EMBEDDING_ACQUIRE_TIMEOUT + EMBEDDING_INFERENCE_TIMEOUT so it cannot
# expire before the server can plausibly respond (admission + a large-text embed,
# ~19-28s). EMBEDDING_TOTAL_TIMEOUT is likewise floored to this budget. Keep coherent
# with EMBEDDING_ACQUIRE_TIMEOUT.
EMBEDDING_INFERENCE_TIMEOUT=30.0
# PLAN-030 WI-10 client load-shaping: cap the rate (texts/sec) at which the client
# submits embeddings, so bulk consumers (github/jira sync) apply patient backpressure
# instead of overrunning the shared server's sustainable compute ceiling (~9.6 txt/s at
# INFERENCE_THREADS=4). <= 0 disables shaping.
EMBEDDING_CLIENT_MAX_TXT_PER_SEC=9.6
# TD-670 embedding-service resilience controls (defaults provisional, tune under live load):
# Max simultaneous model inferences (peak-memory / shared-model guard).
EMBEDDING_MAX_CONCURRENCY=4
# Seconds a request blocks (backpressure) waiting for an inference slot before the
# last-resort shed. Coordinate with the client read timeout; the client retries a shed.
EMBEDDING_ACQUIRE_TIMEOUT=30
# Bounded wait-queue: max requests allowed to block on admission at once. Caps total
# (in-flight + waiting) memory; when full, excess is shed (503 + Retry-After).
EMBEDDING_MAX_WAITERS=64
# Retry-After seconds returned on a last-resort shed (503), honoured by the client.
EMBEDDING_RETRY_AFTER=5
# Reject oversized payloads up front with HTTP 413 (single-request OOM guard):
# max texts per request, max total input chars per request, and max chars per single text.
EMBEDDING_MAX_BATCH_TEXTS=256
# TD-795 (PM #390): shrunk from 1,000,000. At 1M chars one request could reach ~28 GiB
# (~122 texts x 235 MiB) and OOM the 10 GiB cap regardless of concurrency. 200,000 chars
# peaks at ~5.6 GiB transient (+~2.35 GiB warm base = ~7.95 GiB). Keep <= SAFE_INFLIGHT_CHARS.
EMBEDDING_MAX_INPUT_CHARS=200000
# TD-795: per-TEXT char cap. Per-text memory is super-linear (~O(L^2)), so one huge text
# costs far more than the same chars split across texts. 8192 pins the worst per-char cost
# to the measured 235 MiB / 8 KB anchor and is >=3x the largest legit chunk (~2.4 KB).
EMBEDDING_MAX_TEXT_CHARS=8192
# BUG-324 footprint controls (shrink anon-RSS under concurrent inference; conservative
# defaults, tune under the sizing soak):
# Cap glibc malloc arenas — biggest easy win against allocator-fragmentation overshoot.
MALLOC_ARENA_MAX=2
# Bound OpenMP thread pools (BLAS / OpenMP-built ONNX kernels).
# TD-794 (PM #390 X1): 2->4, the measured throughput sweet-spot (monotonic 2->3->4 gain,
# no extra memory). Kept in lockstep with EMBEDDING_INFERENCE_THREADS below.
OMP_NUM_THREADS=4
# Bound the onnxruntime intra-op thread pool (the effective lever on a non-OpenMP
# build; OMP_NUM_THREADS alone won't cap it). TD-794: 4 = measured sweet-spot.
EMBEDDING_INFERENCE_THREADS=4
# BUG-324 Phase 2 memory-aware AIMD self-throttle (the OOM-loop fix). The controller
# reads cgroup-v2 memory signals and collapses effective concurrency toward 1 under
# pressure, recovering when healthy. Conservative defaults; tune under the soak.
# Controller poll interval (seconds).
EMBEDDING_PRESSURE_INTERVAL=1.0
# PSI memory.pressure full avg10 above this (percent) = under pressure -> shrink.
EMBEDDING_PSI_THRESHOLD=10.0
# memory.current/limit ratio above this = under pressure -> shrink concurrency.
# TD-793/X5 (PM #390): lowered 0.9->0.80 as the PORTABLE memory.high fix. The kernel
# cgroup memory.high is not settable via Docker/compose (mem_reservation->memory.low,
# mem_limit->memory.max) and the in-container cgroup is read-only, so this app-level ratio
# IS the throttle threshold. AIMD now sheds at ~8 GiB of the 10 GiB cap (was ~9 GiB).
EMBEDDING_MEMORY_HIGH_RATIO=0.80
# Ratio below which the service is considered healthy enough to grow concurrency again.
# Lowered 0.75->0.65 in lockstep to preserve the 0.15 hysteresis gap (recover at ~6.5 GiB).
EMBEDDING_MEMORY_OK_RATIO=0.65

# --- 4.12 Evaluator (LLM-as-Judge) ---
# Only needed if using provider=custom in evaluator_config.yaml
EVALUATOR_BASE_URL=
# secret — see docker/.env.secrets.example
EVALUATOR_API_KEY=
# Optional override of the baked evaluator config path; leave unset to use the baked default (image-baked, TD-748).
# EVALUATOR_CONFIG_PATH=/app/evaluator_config.yaml

# --- 4.13 Logging ---
# Python log level. Used by: Python config (log_level field in config.py)
# Also accepts: LOG_LEVEL, BMAD_LOG_LEVEL (for backward compatibility)
AI_MEMORY_LOG_LEVEL=INFO
# Qdrant log level (TRACE | DEBUG | INFO | WARN | ERROR). Used by: Docker container
QDRANT_LOG_LEVEL=INFO

# --- 4.14 Secrets Backend (consumed by install.sh / start.sh) ---
# Options: sops-age | keyring | env-file
# Used by: Python config (secrets_backend field in config.py)
# Also accepts: SECRETS_BACKEND (for backward compatibility)
AI_MEMORY_SECRETS_BACKEND=env-file

# --- 4.15 Search & Retrieval Tuning (advanced — defaults match config.py Field defaults) ---
# Minimum vector similarity to return a result (0.0–1.0)
# SIMILARITY_THRESHOLD=0.7
# Near-duplicate detection threshold (0.80–0.99)
# DEDUP_THRESHOLD=0.95
# Cross-collection dedup (catches near-duplicates across collections)
# CROSS_DEDUP_ENABLED=true
# Maximum memories returned per query
# MAX_RETRIEVALS=10
# Token budget for context injection
# TOKEN_BUDGET=4000
# HNSW search precision (fast path — lower is faster)
# HNSW_EF_FAST=64
# HNSW search precision (accurate path — higher is more accurate)
# HNSW_EF_ACCURATE=128
# Injection score gap threshold for adaptive budget
# INJECTION_SCORE_GAP_THRESHOLD=0.15
# Langfuse trace buffer size cap (MB)
# LANGFUSE_TRACE_BUFFER_MAX_MB=50
# Export all spans to Langfuse (false = only root traces)
# LANGFUSE_SHOULD_EXPORT_SPAN=false

# --- 4.16 Per-project env override (multi-project installs) ---
# Path to a per-project .env file layered on top of the global docker/.env.
# The installer writes this automatically when installing for a named project.
# Containers read it via the env_file: directive (required: false — missing file is OK).
# Example: PROJECT_ENV_FILE=/home/user/.ai-memory/projects.d/myproject/.env
PROJECT_ENV_FILE=


# =============================================================================
# SECTION 5: INTERNAL / ADVANCED — DO NOT CHANGE
# =============================================================================
# Ports, hardcoded defaults. Only change if you have port conflicts.
# =============================================================================

# --- Service Connectivity ---
# Qdrant hostname — change only for remote/multi-host setups (default: localhost)
# QDRANT_HOST=localhost
QDRANT_PORT=26350
QDRANT_GRPC_PORT=26351
EMBEDDING_PORT=28080
QDRANT_TIMEOUT=30
QDRANT_USE_HTTPS=false

# --- Langfuse Ports ---
LANGFUSE_WEB_PORT=23100
LANGFUSE_WORKER_PORT=23130
LANGFUSE_POSTGRES_PORT=25432
LANGFUSE_CLICKHOUSE_PORT=28123
LANGFUSE_REDIS_PORT=26379
LANGFUSE_MINIO_PORT=29000

# --- Classification Queue ---
# Used by: Python config (queue_dir field in config.py)
# Also accepts: QUEUE_DIR (for backward compatibility)
AI_MEMORY_QUEUE_DIR=~/.ai-memory/queue

# --- Fixed Defaults ---
GRAFANA_ADMIN_USER=admin

# =============================================================================
# SECTION 6: CONTAINER IDENTITY
# =============================================================================
# Host UID/GID for bind-mount ownership in classifier-worker and github-sync.
# Change only if your host UID/GID differs from 1000 and you see permission errors.
# Note: UID is read-only in bash — do NOT source this file; Compose reads it directly.
# =============================================================================

# Host user ID — used by classifier-worker and github-sync to match bind-mount ownership
UID=1000
# Host group ID — used by classifier-worker and github-sync to match bind-mount ownership
GID=1000
