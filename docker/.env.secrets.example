# =============================================================================
# AI MEMORY MODULE — Sensitive Secrets Template
# =============================================================================
#
# PURPOSE: This file documents all sensitive keys (API keys, passwords, tokens).
#
# USAGE:
#   cp docker/.env.secrets.example docker/.env.secrets
#   chmod 600 docker/.env.secrets   # REQUIRED — protects credentials at rest
#   # Fill in the keys for integrations you use.
#   # Leave blank any integration you don't use.
#
# NOTES:
#   - .env.secrets is gitignored — only .env.secrets.example ships in the repo.
#   - Docker Compose loads .env.secrets as a second env_file layer (required: false).
#     Keys here override matching keys in docker/.env for containers that receive
#     the x-python-service-defaults anchor (monitoring-api, streamlit,
#     classifier-worker, github-sync).
#   - Non-sensitive tunable config stays in docker/.env (chmod 644 is fine).
#   - The installer auto-generates auto-generated keys (Section 2 below).
#     You only need to fill Section 1 (Your API Keys).
#
# PERMISSIONS ENFORCEMENT:
#   This file must be chmod 600 (owner read/write only).
#   The installer enforces this on deploy. If you create this file manually:
#     chmod 600 docker/.env.secrets
#
# IMPORTANT: Do NOT put inline comments on KEY=value lines.
# Docker Compose and pydantic-settings parse them as part of the value.
#
# =============================================================================


# =============================================================================
# SECTION 1: YOUR API KEYS — fill in the integrations you use
# =============================================================================

# --- LLM Providers ---
# Ollama Cloud (optional — local Ollama requires no key)
OLLAMA_API_KEY=
# OpenRouter: https://openrouter.ai/keys (free tier available)
OPENROUTER_API_KEY=
# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- GitHub Integration ---
# Fine-grained token: https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=

# --- Jira Integration ---
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# --- Evaluator (LLM-as-Judge, optional) ---
# Only needed if using provider=custom in evaluator_config.yaml
EVALUATOR_API_KEY=


# =============================================================================
# SECTION 2: AUTO-GENERATED — installer and langfuse_setup.sh populate these
# =============================================================================
# Delete value and re-run installer to regenerate.
# =============================================================================

# --- Vector Database ---
QDRANT_API_KEY=
# Optional read-only key for search operations (falls back to QDRANT_API_KEY)
QDRANT_READ_ONLY_API_KEY=

# --- Monitoring Stack ---
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=
PROMETHEUS_ADMIN_PASSWORD=
# Derived from PROMETHEUS_ADMIN_PASSWORD (installer populates)
PROMETHEUS_BASIC_AUTH_HEADER=

# --- Langfuse Observability (langfuse_setup.sh generates) ---
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_S3_ACCESS_KEY=
LANGFUSE_S3_SECRET_KEY=
# SDK keys for Python tracing (different from bootstrap keys below)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Langfuse Bootstrap (langfuse_setup.sh generates) ---
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_PASSWORD=
