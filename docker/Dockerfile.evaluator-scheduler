FROM python:3.12-slim

LABEL ai-memory.managed="true"
LABEL ai-memory.wipe-policy="exclude"
LABEL org.opencontainers.image.vendor="ai-memory"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies (includes croniter)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bake the evaluator config into the image (default EVALUATOR_CONFIG_PATH).
# Image-bake delivery instead of a single-file bind mount, which is fragile on
# Docker Desktop / WSL2: the single-file source is recreated as a directory on
# host reboot -> runc "not a directory" mount error -> Exit 127 (TD-748). The
# build context is the repo root (compose build.context: ../), so the source is
# the repo-root evaluator_config.yaml. EVALUATOR_CONFIG_PATH can still override.
COPY evaluator_config.yaml /app/evaluator_config.yaml

# Create non-root user (security hardening 2025)
RUN useradd -u 1001 -g users -s /usr/sbin/nologin evaluator && \
    chown -R evaluator:users /app

# Set Python path to include src directory where memory module lives
# (src/ is volume-mounted read-only at runtime: ../src:/app/src:ro)
ENV PYTHONPATH=/app/src

# Switch to non-root user
USER evaluator

# Entry point: evaluator scheduler daemon
CMD ["python", "scripts/memory/evaluator_scheduler.py"]
